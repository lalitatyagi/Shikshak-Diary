# Copy to .env and fill in values. Never commit .env.

# PostgreSQL (matches docker-compose.yml defaults)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/classroom_tracker?schema=public

# API
API_PORT=3001
API_HOST=0.0.0.0
NODE_ENV=development

# Auth. Generate random secrets of at least 32 characters.
# Values starting with change-me are rejected.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Browser origins allowed to call the API with cookies. Comma-separated.
# Production: https://your-app.vercel.app (and preview URLs if needed)
CORS_ORIGINS=http://localhost:5173

# Refresh cookie (defaults: SameSite=Lax locally, SameSite=None + Secure in production)
# COOKIE_SAMESITE=none
# COOKIE_SECURE=true

# Demo users created by `npm run db:seed`
# Class teacher: teacher@demo.local / Teacher123!
# Admin:         admin@demo.local / Admin123!
# Seed refuses NODE_ENV=production — seed Neon once with NODE_ENV=development.

# SMS OTP for sign-up (Twilio). Mode: twilio | log
# log = print code to API console / return as devCode (local + CI only).
# Production should use twilio with real credentials.
SMS_OTP_MODE=log
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+1...
# Optional pepper for hashing OTP codes (defaults to JWT_ACCESS_SECRET)
# OTP_PEPPER=

# Password reset email. Mode: log | smtp (smtp falls back to log until a mailer is wired).
# log = print reset URL to API console / return as devResetToken (local + CI).
EMAIL_RESET_MODE=log
# Optional public web origin for reset links (defaults to first CORS_ORIGINS entry).
# WEB_APP_URL=http://localhost:5173

