# Copy to .env and fill in values. Never commit .env.

# PostgreSQL (matches docker-compose.yml defaults)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/classroom_tracker?schema=public

# API
API_PORT=3001
API_HOST=0.0.0.0
NODE_ENV=development

# Auth. Generate random secrets of at least 32 characters.
# Values starting with change-me are rejected.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Browser origins allowed to call the API with cookies. Comma-separated.
CORS_ORIGINS=http://localhost:5173

# Demo teacher created by `npm run db:seed` (Step 2)
# Email: teacher@demo.local
# Password: Teacher123!
