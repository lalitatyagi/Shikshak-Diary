{
  "name": "classroom-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Mobile-first classroom tracker for school teachers",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:api": "npm run dev -w @classroom-tracker/api",
    "dev:web": "npm run dev -w @classroom-tracker/web",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "npm run db:generate -w @classroom-tracker/api",
    "db:migrate": "npm run db:migrate -w @classroom-tracker/api",
    "db:migrate:dev": "npm run db:migrate:dev -w @classroom-tracker/api",
    "db:seed": "npm run db:seed -w @classroom-tracker/api",
    "db:reset": "npm run db:reset -w @classroom-tracker/api"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^10.0.2",
    "globals": "^16.0.0",
    "prettier": "^3.5.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.25.0"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "@prisma/client@6.5.0": true,
    "@prisma/engines@6.5.0": true,
    "prisma@6.5.0": true,
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true
  },
  "dependencies": {
    "@neon/config": "^1.8.3",
    "@neon/env": "^1.4.8"
  }
}
